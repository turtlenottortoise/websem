    ex:hasOriginalLanguage ex:entity_english ;
    ex:imdbId "tt12037194" ;
    ex:mentionsEntity ex:entity_2015,
        ex:entity_2024,
        ex:entity_angus_sampson,
        ex:entity_anya_taylor_joy,
        ex:entity_dementus,
        ex:entity_furiosa,
