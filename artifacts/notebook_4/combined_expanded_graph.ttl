ex:film_Q126189109 a ex:Film ;
    rdfs:label "The Commandant's Shadow" ;
    ex:directedBy ex:entity_daniela_volker ;
    ex:hasCountry ex:entity_united_kingdom,
        ex:entity_united_states ;
    ex:hasGenre ex:entity_documentary_film ;
