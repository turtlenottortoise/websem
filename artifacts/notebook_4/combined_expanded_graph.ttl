ex:film_Q125910979 a ex:Film ;
    rdfs:label "The Birth of Korea" ;
    ex:directedBy ex:entity_kim_deog_young ;
    ex:hasCountry ex:entity_south_korea ;
    ex:hasGenre ex:entity_documentary_film ;
    ex:hasOriginalLanguage ex:entity_korean ;
