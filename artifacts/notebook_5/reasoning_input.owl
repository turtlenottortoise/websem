  <rdf:Description rdf:about="http://example.org/movie#film_Q124848151">
    <rdfs:label>The Antisocial Network (film)</rdfs:label>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <ns2:hasGenre rdf:resource="http://example.org/movie#entity_documentary_film"/>
    <ns2:imdbId>tt31189868</ns2:imdbId>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_united_states"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_giorgio_angelini"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_feels_good_man"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_jones"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_arthur_jones"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_the_antisocial_network_memes_to_mayhem"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_2024"/>
    <ns2:title>The Antisocial Network (film)</ns2:title>
    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_english"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q124848151"/>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/The_Antisocial_Network_(film)</ns2:pageURL>
    <ns2:sourceSummary>The Antisocial Network: Memes to Mayhem is a 2024 documentary film directed by Arthur Jones and Giorgio Angelini that explores the intersection of internet culture and real-world politics. It was released as a follow-up to Jones' previous work, Feels Good Man. The film discusses the anonymous image board 4chan, and includes interviews from anonymous hackers and ex-members of the website. The film premiered at the 2024 South by Southwest Film Festival.</ns2:sourceSummary>
  </rdf:Description>
