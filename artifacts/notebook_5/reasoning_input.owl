    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_bangla"/>
    <ns2:sourceSummary>Dark World is a 2024 Bangladeshi crime thriller film. It is screenplay and directed by Mostafizur Rahman Manik and dialogues and story by Delwar Hossain Dil. It was produced by Munna Khan under the banner of Munna Khan Multimedia and distributed by The Abhi Kathachitra. Munna Khan and Koushani Mukherjee played the lead roles and Misha Sawdagor, Deepa Khandakar, Borda Mithu, Shiba Shanu, Don, Maruf Akib, Shimul Khan, Chikon Ali and others played supporting roles. It is debut lead role and produced film of Munna Khan under the banner of his own production company Munna Khan Multimedia. It was scheduled for release in theaters on 17 June 2024 on Eid al-Adha.</ns2:sourceSummary>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_bangladesh"/>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
  </rdf:Description>
