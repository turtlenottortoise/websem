    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q130381558"/>
    <ns2:sourceSummary>Gini Avi Saha Gini Keli: Chapter 2 is a 2024 Sri Lankan Sinhalese crime film directed and produced by Udayakantha Warnasuriya for Bahuroo Films. The film served as a sequel to the 1998 blockbuster film Gini Avi Saha Gini Keli, directed and produced by the same director. The film is based on a popular fictitious novel written by Anura Horatious. It stars an ensemble cast of Isuru Lokuhettiarachchi, Dhanuka Dilshan, Rathna Lalani Jayakody and Roger Seneviratne, Gihan Fernando, Kusal Maduranga and Jagath Benaragama. Several actors reprised their roles from previous film including Lucky Dias, Palitha Silva and Rangana Premaratne.</ns2:sourceSummary>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_q18355952"/>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_udayakantha_warnasuriya"/>
    <ns2:title>Gini Avi Saha Gini Keli 2</ns2:title>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Gini_Avi_Saha_Gini_Keli_2</ns2:pageURL>
  </rdf:Description>
