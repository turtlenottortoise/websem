    <rdfs:label>The Day the Earth Blew Up</rdfs:label>
    <ns2:sourceSummary>The Day the Earth Blew Up is a 2024 American animated science fiction comedy film produced by Warner Bros. Animation. Directed by Pete Browngardt in his feature directorial debut, the film is a spin-off from the Looney Tunes Cartoons series developed by Browngardt, and is the first fully animated and theatrically released film in the Looney Tunes franchise consisting of entirely original material. It features the voices of Eric Bauza, Candi Milo, and Peter MacNicol. The film follows Daffy Duck and Porky Pig as they try to save Earth from a chewing gum-based alien scheme.</ns2:sourceSummary>
    <ns2:imdbId>tt15352542</ns2:imdbId>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_peter_browngardt"/>
    <ns2:title>The Day the Earth Blew Up</ns2:title>
    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_english"/>
  </rdf:Description>
