    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_ari_kinarthy"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_nathan_drillot"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_2024"/>
    <ns2:imdbId>tt32021719</ns2:imdbId>
    <ns2:title>Ari's Theme</ns2:title>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q130053447"/>
    <rdfs:label>Ari's Theme</rdfs:label>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ari's_Theme</ns2:pageURL>
    <ns2:sourceSummary>Ari's Theme is a 2024 Canadian documentary film, directed by Nathan Drillot and Jeff Lee Petry. The film profiles Ari Kinarthy, a Canadian composer suffering from type-2 spinal muscular atrophy, as he endeavours to create an epic musical composition that will serve as his artistic legacy.</ns2:sourceSummary>
