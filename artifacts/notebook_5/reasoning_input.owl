  <rdf:Description rdf:about="http://example.org/movie#film_Q133849164">
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_peter_w_klein"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_bribe_inc"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_2024"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_ahsani"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_monaco"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_unaoil"/>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <rdfs:label>Bribe, Inc.</rdfs:label>
    <ns2:sourceSummary>Bribe, Inc. is a 2024 documentary film which explores the corrupt practices of the Monaco-based company Unaoil, run by the Ahsani family. According to the film it conducted an "industrial scale bribery operation" for large corporations looking to win government projects in oil-rich nations. The film was directed by Peter W. Klein.</ns2:sourceSummary>
    <ns2:imdbId>tt34470644</ns2:imdbId>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q133849164"/>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Bribe%2C_Inc.</ns2:pageURL>
    <ns2:title>Bribe, Inc.</ns2:title>
  </rdf:Description>
