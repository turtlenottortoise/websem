    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_english"/>
    <ns2:imdbId>tt30833959</ns2:imdbId>
    <ns2:hasGenre rdf:resource="http://example.org/movie#entity_documentary_film"/>
    <ns2:sourceSummary>Cheech &amp; Chong's Last Movie is a 2024 American documentary film about Tommy Chong and Cheech Marin, who make up the comedy duo Cheech &amp; Chong. The film is directed and produced by David L. Bushell. It premiered at the 2024 South by Southwest Film &amp; TV Festival. It was given a limited theatrical release on April 20, 2025, and then a nationwide release on April 25.</ns2:sourceSummary>
  </rdf:Description>
