    <ns2:title>Bhaiyya Ji</ns2:title>
    <ns2:sourceSummary>Bhaiyaa Ji is a 2024 Indian Hindi-language action thriller film written by Apoorv Singh Karki, who co-wrote it with Deepak Kingrani. It stars Manoj Bajpayee in the titular role, reuniting with Karki after the legal drama Sirf Ek Bandaa Kaafi Hai (2023). It received mixed reviews from critics.</ns2:sourceSummary>
    <ns2:imdbId>tt28654369</ns2:imdbId>
    <rdfs:label>Bhaiyya Ji</rdfs:label>
  </rdf:Description>
