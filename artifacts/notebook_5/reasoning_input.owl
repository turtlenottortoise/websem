  <rdf:Description rdf:about="http://example.org/movie#film_Q130385353">
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_benjamin_turnbull"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_2024"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_toronto"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_harvey"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_devin_shears"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_cherub"/>
    <ns2:sourceSummary>Cherub is a Canadian comedy-drama film, written and directed by Devin Shears and released in 2024. Told almost entirely without dialogue except for two brief lines, the film stars Benjamin Turnbull as Harvey, a shy, lonely and overweight man from Toronto who discovers an opportunity to build new confidence in himself and his body when he learns about the chub subculture in the LGBTQ community, and decides, despite being heterosexual, to submit a photograph of himself to a gay chub magazine's "Cherub of the Month" contest.</ns2:sourceSummary>
    <ns2:title>Cherub (film)</ns2:title>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Cherub_(film)</ns2:pageURL>
    <ns2:imdbId>tt32551579</ns2:imdbId>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q130385353"/>
    <rdfs:label>Cherub (film)</rdfs:label>
  </rdf:Description>
