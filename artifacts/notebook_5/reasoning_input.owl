    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_2024"/>
    <ns2:sourceSummary>Bhairathi Ranagal is a 2024 Indian Kannada-language neo-noir action thriller film directed by Narthan and produced by Geetha Shivarajkumar under Geetha Pictures. A prequel to the 2017 film Mufti, it stars Shiva Rajkumar, alongside Rahul Bose, Rukmini Vasanth, Devaraj, Chaya Singh, Madhu Guruswamy, Shabeer Kallarakkal and Babu Hirannaiah. The music was composed by Ravi Basrur, while the cinematography and editing were composed by Naveen Kumar and Akash Hiremath respectively. This was the first prequel of Kannada cinema.</ns2:sourceSummary>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_india"/>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Bhairathi_Ranagal</ns2:pageURL>
    <ns2:title>Bhairathi Ranagal</ns2:title>
