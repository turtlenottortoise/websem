    <rdfs:label>Baratani: The Hill of Lovers</rdfs:label>
    <ns2:sourceSummary>Baratani: The Hill of Lovers is a 2024 Botswana short film written and directed by Moreetsi Gabang and produced by Tricia L. Sello. A filmic retelling of a popular Tswana folk tale, it features Tshepie Olds, Bernard Morapedi, and Omphile Mabine in lead roles. Warona Itumeleng Mmopelwa, Gaolape A. Basuhi, and Jethro "Umaga" Ndebele feature in supporting roles.</ns2:sourceSummary>
    <ns2:title>Baratani: The Hill of Lovers</ns2:title>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q138773972"/>
