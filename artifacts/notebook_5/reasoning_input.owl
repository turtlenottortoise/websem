    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <ns2:sourceSummary>Blackout is a 2024 Hindi-language comedy thriller film directed by Devang Shashin Bhavsar and produced by Jyoti Deshpande and Niraj Kothari. It stars Vikrant Massey, Ruhani Sharma, Sunil Grover, Mouni Roy, Jisshu Sengupta, Anant Vijay Joshi, Prasad Oak, Kelly Dorji and others. The film was released on 7 June 2024 on JioCinema, to mixed reviews from critics.</ns2:sourceSummary>
    <ns2:title>Blackout (2024 film)</ns2:title>
    <ns2:imdbId>tt27940442</ns2:imdbId>
