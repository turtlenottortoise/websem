    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_united_states"/>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_arthur_bradford"/>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
    <ns2:title>¡Casa Bonita Mi Amor!</ns2:title>
  </rdf:Description>
