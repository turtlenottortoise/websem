    <ns2:sourceSummary>Goodbye Horses: The Many Lives of Q Lazzarus is a 2024 documentary film directed by Eva Aridjis Fuentes. The documentary is about the life and music of American singer Diane Luckey, better known by her stage name Q Lazzarus, who is best known for her song "Goodbye Horses". The song received attention after it was featured in the 1988 film Married to the Mob and the 1991 film The Silence of the Lambs, but Q Lazzarus herself disappeared from the public eye in the mid-1990s. The film includes narration by and interviews with Q Lazzarus herself before her death in 2022.</ns2:sourceSummary>
    <ns2:imdbId>tt21394182</ns2:imdbId>
    <rdfs:label>Goodbye Horses: The Many Lives of Q Lazzarus</rdfs:label>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q132544662"/>
    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_english"/>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Goodbye_Horses%3A_The_Many_Lives_of_Q_Lazzarus</ns2:pageURL>
    <ns2:title>Goodbye Horses: The Many Lives of Q Lazzarus</ns2:title>
  </rdf:Description>
