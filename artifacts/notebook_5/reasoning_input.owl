  <rdf:Description rdf:about="http://example.org/movie#film_Q128034250">
    <ns2:sourceSummary>Footage is a 2024 Indian Malayalam-language thriller film directed by Saiju Sreedharan, marking his directorial debut. The film stars Manju Warrier alongside Vishak Nair and Gayathri Ashok. The film is a found-footage film, a format presenting the narrative through video recordings created by the characters themselves. It is the second found footage movie in Malayalam after Nirmal Baby Varghese's Vazhiye.</ns2:sourceSummary>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_india"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_nirmal_baby_varghese_s"/>
    <ns2:mentionsEntity rdf:resource="http://example.org/movie#entity_malayalam"/>
