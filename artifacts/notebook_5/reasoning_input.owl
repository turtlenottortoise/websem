    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_tamil"/>
    <ns2:sourceSummary>Garudan is a 2024 Indian Tamil-language action drama film written and directed by R. S. Durai Senthilkumar and jointly produced by Vetrimaaran and K. Kumar under Grass Root Film Company and Lark Studios. The film stars Soori, M. Sasikumar and Unni Mukundan in the leading roles, alongside Roshini Haripriyan, Sshivada, Revathi Sharma, Samuthirakani, Vadivukkarasi, R. V. Udayakumar and Mime Gopi in supporting roles. It follows Sokkan, a trusted confidante of two childhood friends Aadhi and Karuna, whose loyalty is changed by a dynamic between betrayal and survival.</ns2:sourceSummary>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_r_s_durai_senthilkumar"/>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_india"/>
