    <ns2:directedBy rdf:resource="http://example.org/movie#entity_sean_mcnamara"/>
    <ns2:sourceSummary>Bau: Artist at War is a 2024 American biographical romance drama film directed by Sean McNamara and starring Emile Hirsch as Holocaust survivor Joseph Bau and Inbar Lavi as his wife Rebecca. The film also stars Josh Zuckerman, Yan Tual, Eugene Lipinski, Josh Blacker, Edward Foy, Chris Cope and Adam Tsekhman, and chronicles Bau's imprisonment in the Kraków-Płaszów concentration camp during World War II, and his subsequent relationship and wedding with Rebecca.</ns2:sourceSummary>
    <ns2:title>Bau: Artist at War</ns2:title>
    <rdfs:label>Bau: Artist at War</rdfs:label>
    <rdf:type rdf:resource="http://example.org/movie#Film"/>
