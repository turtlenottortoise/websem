    <ns2:title>Barroz 3D</ns2:title>
    <rdfs:label>Barroz 3D</rdfs:label>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q85845478"/>
    <ns2:sourceSummary>Barroz 3D is a 2024 Indian children's fantasy film directed by Mohanlal, in his directorial debut, and produced by Antony Perumbavoor's Aashirvad Cinemas. The film stars Mohanlal in the titular role, alongside Maya Rao West, Cesar Lorente Raton, Ignacio Mateos, Kallirroi Tziafeta, Nerea Camacho and Tuhin Menon.The story centers on Barroz, a mysterious, centuries-old guardian spirit entrusted with protecting the hidden treasure of Vasco da Gama. Bound by an ancient spell, Barroz cannot leave his post or hand over the treasure to just anyone. Everything changes when a young girl enters his life.</ns2:sourceSummary>
    <ns2:pageURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Barroz_3D</ns2:pageURL>
    <ns2:directedBy rdf:resource="http://example.org/movie#entity_mohanlal"/>
    <ns2:hasCountry rdf:resource="http://example.org/movie#entity_india"/>
  </rdf:Description>
