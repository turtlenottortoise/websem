    <ns2:imdbId>tt19874970</ns2:imdbId>
    <ns2:sourceSummary>Blink is a 2024 Indian Kannada-language science fiction thriller film written and directed by debutant Srinidhi Bengaluru. The film stars Dheekshith Shetty and Chaithra J Achar in lead roles. The soundtrack and background score were composed by Prasanna Kumar MS, while the cinematography handled by Avinaasha Shastry and editing done by Sanjeev Jagirdar.</ns2:sourceSummary>
    <ns2:hasOriginalLanguage rdf:resource="http://example.org/movie#entity_kannada"/>
