        ns1:entity_the_angers_european_first_film_festival,
        ns1:entity_the_cinefondation_la_selection,
        ns1:entity_the_clermont_ferrand_international_short_film_festival,
        ns1:entity_the_edinburgh_international_film_festival,
        ns1:entity_the_manchester_animation_festival,
        ns1:entity_the_mumbai_film_festival,
        ns1:entity_the_national_film_and_television_school,
