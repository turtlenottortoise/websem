ns1:film_Q133449008 a ns1:Film ;
    rdfs:label "Bunnyhood" ;
    ns1:imdbId "tt31548153" ;
    ns1:mentionsEntity ns1:entity_2024,
        ns1:entity_2025,
        ns1:entity_ashionye_ogene,
        ns1:entity_best_student_film,
        ns1:entity_dok_leipzig,
