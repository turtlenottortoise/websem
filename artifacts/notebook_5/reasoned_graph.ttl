ns1:film_Q125910979 a ns1:Film ;
    rdfs:label "The Birth of Korea" ;
    ns1:directedBy ns1:entity_kim_deog_young ;
    ns1:hasCountry ns1:entity_south_korea ;
    ns1:hasGenre ns1:entity_documentary_film ;
