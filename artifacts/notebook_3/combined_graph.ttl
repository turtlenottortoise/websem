ex:film_Q85845478 a ex:Film ;
    rdfs:label "Barroz 3D" ;
    ex:directedBy ex:entity_mohanlal ;
    ex:hasCastMember ex:entity_antony_perumbavoor,
        ex:entity_guru_somasundaram,
        ex:entity_ignacio_mateos,
        ex:entity_kallirroi_tziafeta,
        ex:entity_kirtana_kumar,
        ex:entity_komal_sharma,
        ex:entity_mammootty,
        ex:entity_mohanlal,
        ex:entity_pranav_mohanlal,
        ex:entity_q857388,
        ex:entity_suneeta_rao ;
    ex:hasCountry ex:entity_india ;
    ex:imdbId "tt10345546" ;
    ex:mentionsEntity ex:entity_aashirvad_cinemas,
        ex:entity_antony_perumbavoor_s,
        ex:entity_barroz_3d,
        ex:entity_centuries_old,
        ex:entity_cesar_lorente_raton,
        ex:entity_ignacio_mateos,
        ex:entity_kallirroi_tziafeta,
        ex:entity_maya_rao_west,
        ex:entity_mohanlal,
        ex:entity_nerea_camacho,
        ex:entity_tuhin_menon ;
    ex:pageURL "https://en.wikipedia.org/wiki/Barroz_3D"^^xsd:anyURI ;
    ex:sourceSummary "Barroz 3D is a 2024 Indian children's fantasy film directed by Mohanlal, in his directorial debut, and produced by Antony Perumbavoor's Aashirvad Cinemas. The film stars Mohanlal in the titular role, alongside Maya Rao West, Cesar Lorente Raton, Ignacio Mateos, Kallirroi Tziafeta, Nerea Camacho and Tuhin Menon.The story centers on Barroz, a mysterious, centuries-old guardian spirit entrusted with protecting the hidden treasure of Vasco da Gama. Bound by an ancient spell, Barroz cannot leave his post or hand over the treasure to just anyone. Everything changes when a young girl enters his life." ;
    ex:title "Barroz 3D" .

ex:film_Q96378044 a ex:Film ;
    rdfs:label "The Fire Inside (film)" ;
    ex:directedBy ex:entity_rachel_morrison ;
    ex:hasCastMember ex:entity_brian_tyree_henry,
        ex:entity_de_adre_aziza,
        ex:entity_ice_cube,
        ex:entity_judy_greer,
        ex:entity_olunike_adeliyi,
        ex:entity_ryan_destiny ;
    ex:hasCountry ex:entity_united_states ;
    ex:hasGenre ex:entity_biographical_film,
        ex:entity_boxing_film,
        ex:entity_sport_film ;
    ex:imdbId "tt6133444" ;
    ex:mentionsEntity ex:entity_2024,
        ex:entity_adam_clark,
        ex:entity_brian_tyree,
        ex:entity_claressa,
        ex:entity_flint,
        ex:entity_henry,
        ex:entity_michigan,
        ex:entity_rachel_morrison,
        ex:entity_ryan_destiny,
        ex:entity_shields ;
    ex:pageURL "https://en.wikipedia.org/wiki/The_Fire_Inside_(film)"^^xsd:anyURI ;
    ex:sourceSummary "The Fire Inside is a 2024 American biographical sports drama film by Rachel Morrison in her feature directorial debut. The film is about the early boxing career of Claressa \"T-Rex\" Shields, a fighter from Flint, Michigan, including her competing at the 2012 Summer Olympics. Ryan Destiny stars as Shields, alongside Brian Tyree Henry and Adam Clark." ;
    ex:title "The Fire Inside (film)" .

